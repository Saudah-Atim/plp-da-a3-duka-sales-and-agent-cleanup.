    {
      "cell_type": "code",
      "source": [
        "# Check data quality issues\n",
        "duplicate_count = txns[\"txn_id\"].duplicated().sum()\n",
        "\n",
        "type_count = (~txns[\"txn_type\"].isin([\"Deposit\", \"Withdrawal\"])).sum()\n",
        "\n",
        "missing_count = txns[\"amount\"].isna().sum()\n",
        "\n",
        "invalid_amount_count = (\n",
        "    pd.to_numeric(txns[\"amount\"], errors=\"coerce\").isna()\n",
        "    & txns[\"amount\"].notna()\n",
        ").sum()\n",
        "\n",
        "date_count = txns[\"txn_date\"].str.contains(\"/\", regex=False).sum()\n",
        "\n",
        "unknown_agent_count = (~txns[\"agent_id\"].isin(agents[\"agent_id\"])).sum()\n",
        "\n",
        "# Create the audit table\n",
        "audit_df = pd.DataFrame([\n",
        "    [\"Duplicate transactions\", \"Uniqueness\", \"txn_id\", duplicate_count],\n",
        "    [\"Inconsistent transaction types\", \"Consistency\", \"txn_type\", type_count],\n",
        "    [\"Missing amounts\", \"Completeness\", \"amount\", missing_count],\n",
        "    [\"Invalid amounts\", \"Validity\", \"amount\", invalid_amount_count],\n",
        "    [\"Inconsistent date formats\", \"Validity\", \"txn_date\", date_count],\n",
        "    [\"Unknown agents\", \"Referential integrity\", \"agent_id\", unknown_agent_count]\n",
        "], columns=[\"Issue\", \"Dimension\", \"Affected Column\", \"Affected Rows\"])\n",
        "\n",
        "display(audit_df)"
      ],
