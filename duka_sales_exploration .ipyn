        "# Convert txn_date to datetime to allow dt operations\n",
        "merged_txns[\"txn_date\"] = pd.to_datetime(merged_txns[\"txn_date\"], errors=\"coerce\")\n",
        "\n",
        "# Create a week column\n",
        "merged_txns[\"week\"] = merged_txns[\"txn_date\"].dt.to_period(\"W\")\n",
        "\n",
        "# Create pivot table\n",
        "weekly_pivot = merged_txns.pivot_table(\n",
        "    index=\"week\",\n",
        "    columns=\"county\",\n",
        "    values=\"amount\",\n",
        "    aggfunc=\"sum\"\n",
        ")\n",
        "print(weekly_pivot)"
      ],
