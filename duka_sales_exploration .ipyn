    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Convert amount to numeric values\n",
        "txns[\"amount\"] = pd.to_numeric(txns[\"amount\"], errors=\"coerce\")\n",
        "\n",
        "# Check the amount data type\n",
        "print(txns[\"amount\"].dtype)\n",
        "\n",
        "# Check missing amounts\n",
        "print(\"Missing amounts:\", txns[\"amount\"].isna().sum())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
