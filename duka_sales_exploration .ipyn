    {
      "cell_type": "code",
      "source": [
        "# Flag transactions with missing amounts\n",
        "txns[\"amount_flag\"] = txns[\"amount\"].isna()\n",
        "display(txns[txns[\"amount_flag\"] == True])\n",
        "print(\"Transactions with missing amounts:\", txns[\"amount_flag\"].sum())\n",
        "print(\"Available amounts:\", txns[\"amount\"].notna().sum())\n"
      ],
