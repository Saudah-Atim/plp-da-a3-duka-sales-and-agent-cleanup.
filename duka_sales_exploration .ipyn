              "summary": "{\n  \"name\": \"print(\\\"Transactions shape:\\\", txns\",\n  \"rows\": 5,\n  \"fields\": [\n    {\n      \"column\": \"txn_id\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 5,\n        \"samples\": [\n          \"TX00002\",\n          \"TX00005\",\n          \"TX00003\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"agent_id\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"AG009\",\n          \"AG020\",\n          \"AG008\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"txn_type\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"deposit\",\n          \"DEPOSIT \",\n          \"withdrawal\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"amount\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 3793.5795101724175,\n        \"min\": 353.0,\n        \"max\": 9129.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          1238.0,\n          478.0,\n          9129.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"txn_date\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 5,\n        \"samples\": [\n          \"2026-04-27\",\n          \"2026-04-17\",\n          \"2026-04-29\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
