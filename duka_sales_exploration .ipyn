    {
      "cell_type": "code",
      "source": [
        "#  Premium Online orders from Nairobi and Mombasa\n",
        "premium_online = sales[\n",
        "    (sales[\"price_band\"] == \"Premium\") &\n",
        "    (sales[\"channel\"] == \"Online\") &\n",
        "    (sales[\"branch\"].isin([\"Nairobi\", \"Mombasa\"]))\n",
        "]\n",
        "\n",
        "# Count the orders\n",
        "print(\"Number of orders:\", len(premium_online))\n",
        "\n",
        "# Calculate total revenue\n",
        "print(\"Total revenue:\", premium_online[\"revenue\"].sum())\n",
        "\n",
        "# Export the filtered data to CSV\n",
        "premium_online.to_csv(\"premium_online_coast_capital.csv\", index=False)\n",
        "\n",
        "import os\n",
        "\n",
        "print(os.path.exists(\"premium_online_coast_capital.csv\"))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
