    {
      "cell_type": "code",
      "source": [
        "# Count duplicate transactions\n",
        "duplicate_count = txns[\"txn_id\"].duplicated().sum()\n",
        "\n",
        "# Remove duplicate transactions\n",
        "txns = txns.drop_duplicates(subset=\"txn_id\").copy()\n",
        "print(\"Duplicate transactions removed:\", duplicate_count)\n",
        "print(\"Transactions remaining:\", len(txns))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "DtqFU717DW80",
        "outputId": "879491f8-cfb6-4a7f-e013-3c7360788783"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Duplicate transactions removed: 12\n",
            "Transactions remaining: 600\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Check for missing transaction types\n",
        "print(\"Missing transaction types:\")\n",
        "print(txns[\"txn_type\"].isna().sum())\n",
        "\n",
        "# Check the transaction types and their counts\n",
        "print(\"\\nTransaction types:\")\n",
        "print(txns[\"txn_type\"].value_counts(dropna=False))\n",
        "\n",
        "# Check invalid transaction types\n",
        "valid_types = [\"Deposit\", \"Withdrawal\"]\n",
        "\n",
        "invalid_types = txns[\n",
        "    txns[\"txn_type\"].notna() &\n",
        "    ~txns[\"txn_type\"].str.strip().str.title().isin(valid_types)\n",
        "]\n",
        "\n",
        "print(\"\\nInvalid transaction types:\")\n",
        "display(invalid_types[[\"txn_id\", \"txn_type\"]])\n",
        "\n",
        "# Standardise transaction types\n",
        "txns[\"txn_type\"] = txns[\"txn_type\"].str.strip().str.title()\n",
        "\n",
        "# Check the cleaned transaction types\n",
        "print(txns[\"txn_type\"].value_counts())"
      ],
